# Backend port on your dev machine (used with Metro's auto-detected host).
# Default: 3002
EXPO_PUBLIC_API_PORT=3002

# Optional — only set when you need a fixed URL:
# - Production / EAS builds (deployed API)
# - ngrok or Cloudflare tunnel while away from home
# - Explicit override during local dev
#
# If unset in dev, the app uses the same IP as `npx expo start` (no hardcoded LAN IP).
# EXPO_PUBLIC_API_URL=https://your-api.example.com

# Clerk publishable key (dashboard.clerk.com → API keys)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
