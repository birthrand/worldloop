PORT=3001
NODE_ENV=development

# Cache (required for local dev — see repo-root docker-compose.yml)
# Use 127.0.0.1 on Windows if localhost fails (IPv6/socket reset)
REDIS_URL=redis://127.0.0.1:6379

# External data (REST Countries v5 — https://restcountries.com/sign-up)
# Free tier is limited; feed basics are cached in Redis for 7 days to save quota.
REST_COUNTRIES_BASE_URL=https://api.restcountries.com/countries/v5
REST_COUNTRIES_API_KEY=

# Image APIs (server-side only — never expose in the Expo app)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# AI (server-side only — never expose in the Expo app)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Protect POST /ai/generate from direct public abuse (optional in dev)
INTERNAL_API_KEY=

# News APIs (server-side only — never expose in the Expo app)
GNEWS_API_KEY=
CURRENTS_API_KEY=
