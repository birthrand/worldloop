PORT=3001
NODE_ENV=development

# Cache (required for local dev — see repo-root docker-compose.yml)
REDIS_URL=redis://localhost:6379

# External data
REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1

# Image APIs (server-side only — never expose in the Expo app)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# AI (server-side only — never expose in the Expo app)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Protect POST /ai/generate from direct public abuse (optional in dev)
INTERNAL_API_KEY=

# News APIs (server-side only — never expose in the Expo app)
GNEWS_API_KEY=
CURRENTS_API_KEY=
